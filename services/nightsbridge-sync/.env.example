# Copy to .env and fill in real values (.env is git-ignored)

# NightsBridge login (NB_* preferred; SITE_* still supported)
NB_USERNAME=your-nightsbridge-username
NB_PASSWORD=your-nightsbridge-password
# SITE_USER=your-nightsbridge-username
# SITE_PASS=your-nightsbridge-password

# Supabase (service role — scraper only, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Run the browser without a visible window (true) or with one (false).
HEADLESS=true

# Optional date range for bookings (YYYY-MM-DD).
# DATE_FROM=2026-06-01
# DATE_TO=2026-12-31

# Background worker interval (minutes)
# SYNC_INTERVAL_MINUTES=60
