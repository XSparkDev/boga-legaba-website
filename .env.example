# Boga Legaba — Next.js (copy to .env.local and fill in)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NightsBridge owner login (sync worker / scraper only)
SITE_USER=your-nightsbridge-username
SITE_PASS=your-nightsbridge-password

# Analytics & contact
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_WA_CHABABA=https://wa.me/27828757018?text=Hi%2C+I%27d+like+to+enquire+about+Chababa
NEXT_PUBLIC_WA_INTERLAKEN_A=https://wa.me/27828757018?text=Hi%2C+I%27d+like+to+enquire+about+Interlaken+A
NEXT_PUBLIC_WA_LANTANA=https://wa.me/27828757018?text=Hi%2C+I%27d+like+to+enquire+about+Lantana

# Email (optional)
RESEND_API_KEY=re_XXXXXXXXXX

# Shared secret — Railway worker POST /run + Supabase Edge Function
CRON_SECRET=your-long-random-secret

# Optional: audit page /admin/nightsbridge?key=
NB_AUDIT_KEY=another-random-string

# Optional: manual trigger via Next.js POST /api/sync
# SYNC_WORKER_URL=https://your-railway-worker.up.railway.app/run

# Railway deploy — see services/sync-worker/README.md
# SUPABASE_PROJECT_REF=your-project-ref (for scripts/deploy-edge-function.sh)
